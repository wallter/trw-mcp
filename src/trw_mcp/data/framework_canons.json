{
  "schema_version": 2,
  "policy": "artifacts[].authoring_source is the hand-edited body that tracked_mirrors are generated byte-identical copies of; for framework/aaref that is framework.md / aaref.md, edited directly (S4 retired the marked *.source.md, the compact_core/reference views and their promotion gates). package_resource is the bundled name of the artifact. install_targets are managed destinations in a deployed project (install/runtime view), inspected separately from mirrors because deployed state may be ignored or untracked. version_surfaces are governed version-bearing occurrences classified by usage (PRD-INFRA-164 FR11 / PRD-QUAL-115 vocabulary). scripts/check-aaref-sync.py enforces mirror parity.",
  "artifacts": [
    {
      "id": "framework",
      "kind": "canon",
      "package_resource": "framework.md",
      "authoring_source": "trw-mcp/src/trw_mcp/data/framework.md",
      "tracked_mirrors": [
        "FRAMEWORK.md",
        ".trw/frameworks/FRAMEWORK.md",
        "trw-mcp/FRAMEWORK.md"
      ],
      "install_targets": [
        {
          "path": ".trw/frameworks/FRAMEWORK.md",
          "role": "runtime",
          "update_policy": "managed"
        },
        {
          "path": "FRAMEWORK.md",
          "role": "project_reference",
          "update_policy": "managed"
        }
      ],
      "version": {
        "extractor": "framework_header",
        "config_field": "framework_version"
      }
    },
    {
      "id": "aaref",
      "kind": "canon",
      "package_resource": "aaref.md",
      "authoring_source": "trw-mcp/src/trw_mcp/data/aaref.md",
      "tracked_mirrors": [
        "AARE-F-FRAMEWORK.md",
        ".trw/frameworks/AARE-F-FRAMEWORK.md"
      ],
      "install_targets": [
        {
          "path": ".trw/frameworks/AARE-F-FRAMEWORK.md",
          "role": "runtime",
          "update_policy": "managed"
        },
        {
          "path": "AARE-F-FRAMEWORK.md",
          "role": "project_reference",
          "update_policy": "managed"
        }
      ],
      "version": {
        "extractor": "aaref_header",
        "config_field": "aaref_version"
      }
    },
    {
      "id": "prd_template",
      "kind": "template",
      "package_resource": "prd_template.md",
      "authoring_source": "trw-mcp/src/trw_mcp/data/prd_template.md",
      "tracked_mirrors": [],
      "install_targets": [],
      "version": {
        "extractor": "template_footer",
        "config_field": null
      }
    }
  ],
  "version_surfaces": [
    {
      "id": "installer_snapshot_framework",
      "path": ".trw/installer-meta.yaml",
      "selector": "framework_version_at_install",
      "usage": "historical_install_snapshot"
    },
    {
      "id": "installer_snapshot_aaref",
      "path": ".trw/installer-meta.yaml",
      "selector": "aaref_version_at_install",
      "usage": "historical_install_snapshot"
    },
    {
      "id": "comprehensive_guide",
      "path": "docs/TRW-COMPREHENSIVE-GUIDE.md",
      "selector": null,
      "usage": "version_agnostic"
    },
    {
      "id": "documentation_index",
      "path": "docs/documentation/INDEX.md",
      "selector": null,
      "usage": "version_agnostic"
    },
    {
      "id": "agent_guide",
      "path": "docs/documentation/agent-guide.md",
      "selector": null,
      "usage": "version_agnostic"
    },
    {
      "id": "architecture_overview",
      "path": "docs/documentation/architecture-overview.md",
      "selector": null,
      "usage": "version_agnostic"
    },
    {
      "id": "prd_implementation_status",
      "path": "docs/documentation/prd-implementation-status.md",
      "selector": null,
      "usage": "version_agnostic"
    }
  ]
}
